<ul class="pub-list">
<% for (const item of items) { %>
<li class="pub">
<div class="pub-title"><%= item.title %></div>
<div class="pub-authors"><%= item.authors %></div>
<div class="pub-venue"><% if (item.journal) { %><em><%= item.journal %></em><% } %><% if (item.year) { %> (<%= item.year %>)<% } %><% if (item.doi) { %> · <a href="https://doi.org/<%= item.doi %>">doi:<%= item.doi %></a><% } %><% if (item.url) { %> · <a href="<%= item.url %>">link</a><% } %></div>
</li>
<% } %>
</ul>

